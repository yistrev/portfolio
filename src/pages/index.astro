---
import Base from '../layouts/Base.astro';

/* ------------------------------------------------------------------
   メンフィス幾何コンポジション。
   写真素材が使えないので、展示物そのものをベタ色の幾何形で描く。
   共通の語彙: 台座のバー ／ 円 ／ 三角 ／ 縞 ／ うねる線 ／ 点列。
   色は tokens.css の CSS 変数を参照（インラインSVGなので継承される）。
------------------------------------------------------------------ */
const art = {
  // 積み上がるブロック — フロントエンド実装
  build: `<svg viewBox="0 0 240 240" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
    <rect x="34" y="26" width="58" height="58" fill="var(--c-blue)" />
    <path d="M92 26h62l-30 58H92z" fill="var(--c-yellow)" />
    <circle cx="188" cy="55" r="29" fill="var(--c-orange)" />
    <rect x="34" y="98" width="172" height="20" fill="var(--c-ink)" />
    <rect x="56" y="132" width="34" height="76" fill="var(--c-slate)" />
    <rect x="150" y="132" width="34" height="76" fill="var(--c-slate)" />
    <path d="M90 132h60v76H90z" fill="var(--c-pink)" />
    <rect x="34" y="208" width="172" height="14" fill="var(--c-ink)" />
  </svg>`,

  // 縞の柱 — CMS設計・構築
  cms: `<svg viewBox="0 0 240 240" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
    <circle cx="120" cy="40" r="30" fill="var(--c-turquoise)" />
    <rect x="82" y="74" width="76" height="18" fill="var(--c-ink)" />
    <rect x="82" y="100" width="76" height="18" fill="var(--c-yellow)" />
    <rect x="82" y="126" width="76" height="18" fill="var(--c-ink)" />
    <rect x="82" y="152" width="76" height="18" fill="var(--c-orange)" />
    <rect x="82" y="178" width="76" height="18" fill="var(--c-ink)" />
    <path d="M28 204h184v18H28z" fill="var(--c-blue)" />
    <path d="M28 74l40 122H28z" fill="var(--c-pink)" />
    <path d="M212 74l-40 122h40z" fill="var(--c-pink)" />
  </svg>`,

  // コンパスと扇 — 要件整理・設計
  plan: `<svg viewBox="0 0 240 240" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
    <path d="M40 172a80 80 0 0 1 160 0z" fill="var(--c-yellow)" />
    <path d="M80 172a40 40 0 0 1 80 0z" fill="var(--c-blue)" />
    <circle cx="120" cy="172" r="12" fill="var(--c-ink)" />
    <path d="M120 24l34 60h-68z" fill="var(--c-olive)" />
    <rect x="30" y="188" width="180" height="16" fill="var(--c-ink)" />
    <circle cx="44" cy="52" r="18" fill="var(--c-coral)" />
    <rect x="186" y="34" width="16" height="72" fill="var(--c-peri)" />
  </svg>`,

  // 軌道と点列 — 運用・保守
  ops: `<svg viewBox="0 0 240 240" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
    <path d="M28 96c26-44 76-44 102 0s76 44 102 0" stroke="var(--c-blue)" stroke-width="14" fill="none" />
    <path d="M28 140c26-44 76-44 102 0s76 44 102 0" stroke="var(--c-pink)" stroke-width="14" fill="none" />
    <circle cx="60" cy="196" r="14" fill="var(--c-ink)" />
    <circle cx="104" cy="196" r="14" fill="var(--c-ink)" />
    <circle cx="148" cy="196" r="14" fill="var(--c-yellow)" />
    <circle cx="192" cy="196" r="14" fill="var(--c-ink)" />
    <rect x="98" y="24" width="44" height="44" fill="var(--c-olive)" />
  </svg>`,

  // ヒーローのトーテム（上の語彙を1本に積んだ主役の一点）
  totem: `<svg viewBox="0 0 200 320" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
    <circle cx="100" cy="40" r="34" fill="var(--c-blue)" />
    <path d="M100 84l40 52H60z" fill="var(--c-orange)" />
    <rect x="46" y="146" width="108" height="14" fill="var(--c-ink)" />
    <rect x="46" y="168" width="108" height="14" fill="var(--c-ink)" />
    <rect x="46" y="190" width="108" height="14" fill="var(--c-ink)" />
    <path d="M22 216h156v22H22z" fill="var(--c-pink)" />
    <rect x="62" y="238" width="26" height="58" fill="var(--c-slate)" />
    <rect x="112" y="238" width="26" height="58" fill="var(--c-slate)" />
    <rect x="10" y="296" width="180" height="16" fill="var(--c-ink)" />
    <circle cx="172" cy="112" r="16" fill="var(--c-olive)" />
  </svg>`,
};

/* Nº02 Capability = 展示物のリスト。作品キャプションの体裁で淡々と並べる */
const exhibits = [
  {
    fig: 'Fig. 01',
    title: 'フロントエンド実装',
    period: '2016年 —（設計 / 実装）',
    material: 'HTML, CSS / Sass, JavaScript, GSAP',
    note: 'インタラクティブなUIの実装',
    bg: 'var(--c-paper)',
    art: art.build,
  },
  {
    fig: 'Fig. 02',
    title: 'CMS設計・構築',
    period: '2017年 —（設計 / 構築 / 改修）',
    material: 'WordPress 自作テーマ, PHP',
    note: '更新される前提の構造をつくる',
    bg: 'var(--c-mint)',
    art: art.cms,
  },
  {
    fig: 'Fig. 03',
    title: '要件整理・設計',
    period: '2019年 —（要件定義 / 見積）',
    material: 'ヒアリング, 仕様定義, 実現可能性の検証',
    note: '行間を読んで仕様に書き起こす',
    bg: 'var(--c-paper)',
    art: art.plan,
  },
  {
    fig: 'Fig. 04',
    title: '運用・保守',
    period: '2016年 —（移行 / 保守）',
    material: 'サーバー移行, SEO, セキュリティ対応',
    note: '公開後の環境を整え続ける',
    bg: 'var(--c-coral)',
    art: art.ops,
  },
];

/* Nº03 Spec（仕様表） */
const spec = [
  { label: 'Markup', items: ['HTML', 'CSS / Sass', 'BEM', 'レスポンシブ対応', 'アクセシビリティ'] },
  { label: 'Program', items: ['JavaScript', 'jQuery', 'GSAP', 'PHP', 'Vue.js / Nuxt.js'] },
  { label: 'CMS / FW', items: ['WordPress 自作テーマ', 'Tailwind CSS', 'Bulma'] },
  { label: 'Learning', items: ['React / Next.js', 'TypeScript', 'Three.js / WebGL', 'Blender'], learning: true },
];

/* 題字の帯（装飾・aria-hidden）。1語おきに中抜きにして濃淡をつける */
const marqueeWords = ['Rootscion', 'Web Engineer', 'Build It Right'];
---

<Base title="rootscion | Web Engineer">
  <main>
    <!-- ============ 表紙（展覧会のタイトル面） ============ -->
    <section class="hero" id="top">
      <!-- 図版プレート: イエローの色面と、その上に立つトーテム。
           デスクトップは右上に絶対配置、モバイルは本文の下の帯になる（文字と重ねない） -->
      <div class="hero__plate" aria-hidden="true">
        <div class="hero__field"></div>
        <div class="hero__composition" data-composition set:html={art.totem} />
      </div>

      <div class="hero__inner">
        <p class="hero__eyebrow">
          <span>rootscion — portfolio</span>
          <span>Nº00 / Cover</span>
          <span><a href="/engineer">Mode: engineer →</a></span>
        </p>

        <h1 class="hero__title" data-hero-title>
          <span class="line"><span>Root</span></span>
          <span class="line"><span>the web,</span></span>
          <span class="line"><span>grow it</span></span>
          <span class="line"><span><em>right.</em></span></span>
        </h1>

        <p class="hero__jp">
          対話から生まれたアイデアの「根（ルーツ）」を、確かな構造のコードへ。
          設計から実装、運用まで——Webサイトの「つくる工程」に高い解像度で向き合い、かたちにします。
        </p>

        <div class="hero__foot">
          <p class="hero__role">
            Web Engineer<br />
            Yuri Ishikawa — Osaka, Japan
          </p>
          <p class="hero__scroll">Scroll</p>
        </div>
      </div>
    </section>

    <!-- ============ 題字の帯（スクロール量で流す） ============ -->
    <div class="marquee" aria-hidden="true" data-marquee>
      <div class="marquee__track">
        {
          [0, 1].map(() => (
            <span class="marquee__item">
              {marqueeWords.map((word, i) => (
                <>
                  <span class={i === 1 ? 'hollow' : undefined}>{word}</span>
                  <span class="dot" />
                </>
              ))}
            </span>
          ))
        }
      </div>
    </div>

    <!-- ============ ステートメント（引用ひとつだけの部屋） ============ -->
    <section class="room statement">
      <div class="room__inner">
        <blockquote class="statement__quote" data-statement>
          <span class="line">設計がはじまるのは、</span>
          <span class="line">言われた通りに組む手が止まり、</span>
          <span class="line">行間を読む仕事が</span>
          <span class="line">はじまるときである。</span>
        </blockquote>
        <p class="statement__source">
          rootscion — 制作のスタンス
        </p>
      </div>
    </section>

    <!-- ============ Nº01 About ============ -->
    <section class="room about" id="about">
      <div class="room__inner">
        <div class="room-head">
          <p class="room-head__num" aria-hidden="true" data-room-num><span>01</span></p>
          <h2 class="room-head__en">About</h2>
          <p class="room-head__jp">Nº01 — この場所について</p>
        </div>

        <div class="about__grid">
          <h3 class="about__pull" data-pull>
            <span class="u-block">仕様書の行間まで読んで、</span><span class="u-block"
              ><span class="u-mark">コードに落とす。</span></span
            >
          </h3>

          <div class="about__text" data-reveal>
            <p>
              仕様書の通りに組むだけでなく、その行間にある課題やクライアントの真意まで
              汲み取ってコードに落とし込む。それが、この場所の<span class="accent">エンジニアリングの流儀</span>です。
            </p>
            <p>
              設計から実装、公開後の運用まで。「つくる工程」の全域に高い解像度で向き合い、
              対話から生まれた思考の根（ルーツ）を、ビジネスの場で駆動する確かな「幹（サイオン）」へと育てます。
            </p>
            <p class="about__origin">roots + (s)cion — 広げた興味の根から、たしかな「幹」を育てる</p>
            <p class="about__links">
              <a href="https://github.com/yistrev" target="_blank" rel="noopener">GitHub →</a>
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- ============ Nº02 Capability（展示室） ============ -->
    <section class="room capability" id="capability">
      <div class="room__inner">
        <div class="room-head">
          <p class="room-head__num" aria-hidden="true" data-room-num><span>02</span></p>
          <h2 class="room-head__en">Capability</h2>
          <p class="room-head__jp">Nº02 — できることの展示</p>
        </div>

        <ul class="exhibits">
          {
            exhibits.map((ex) => (
              <li class="exhibit" data-exhibit>
                <div class="exhibit__stage" style={`--exhibit-bg:${ex.bg}`}>
                  <Fragment set:html={ex.art} />
                </div>
                <div class="plate">
                  <span class="exhibit__no">{ex.fig}</span>
                  <span class="plate__title">{ex.title}</span>
                  <span class="plate__author">{ex.note}</span>
                  <span class="plate__row">{ex.period}</span>
                  <span class="plate__row">{ex.material}</span>
                  <span class="plate__copy">© rootscion</span>
                </div>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <!-- ============ Nº03 Spec（暗室） ============ -->
    <section class="room spec room--dark" id="skills">
      <div class="room__inner">
        <div class="room-head">
          <p class="room-head__num" aria-hidden="true" data-room-num><span>03</span></p>
          <h2 class="room-head__en">Spec</h2>
          <p class="room-head__jp">Nº03 — 仕様</p>
        </div>

        <table class="spec-sheet">
          <tbody>
            {
              spec.map((row) => (
                <tr class={row.learning ? 'is-learning' : undefined} data-reveal>
                  <th scope="row">{row.label}</th>
                  <td>
                    {row.items.map((item) => (
                      <span class="tag">{item}</span>
                    ))}
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
        <p class="spec__footnote">Learning = いま root を伸ばしている領域</p>
      </div>
    </section>

    <!-- ============ Nº04 Profile ============ -->
    <section class="room profile" id="profile">
      <div class="room__inner">
        <div class="room-head">
          <p class="room-head__num" aria-hidden="true" data-room-num><span>04</span></p>
          <h2 class="room-head__en">Profile</h2>
          <p class="room-head__jp">Nº04 — 作り手について</p>
        </div>

        <div class="profile__grid">
          <p class="profile__intro" data-reveal>
            Web制作に携わって約10年。受託制作の現場で要件定義や運用・構築の基礎を学んだのち、
            現在はデザイン会社でWebエンジニアとして制作に携わっています。<br /><br />
            デザインの意図や繊細なニュアンスを汲み取りながら、仕組みを緻密に組み上げていく
            「つくる工程」そのものが自分の原点です。<br />
            技術やトレンドが変わっても、手がけたWebサイトが誰かの役に立ち、
            日々を少し良くする瞬間を楽しみにコードを書いています。
          </p>

          <dl class="profile__list" data-reveal>
            <div><dt>Handle</dt><dd>rootscion（ルーツサイオン）</dd></div>
            <div><dt>Name</dt><dd>YURI ISHIKAWA</dd></div>
            <div><dt>Role</dt><dd>Web Engineer</dd></div>
            <div><dt>Experience</dt><dd>10+ years in Web Development</dd></div>
            <div><dt>Background</dt><dd>Contract Production → Design Studio</dd></div>
            <div><dt>Favorites</dt><dd>gadgets / tactile audio gear / minimalist setups</dd></div>
            <div>
              <dt>Now</dt>
              <dd><span class="live-dot" aria-hidden="true"></span>Blender &amp; 3D Web Graphics を学習中</dd>
            </div>
          </dl>
        </div>
      </div>
    </section>

    <!-- ============ Nº05 Contact ============ -->
    <section class="room contact room--dark" id="contact">
      <div class="room__inner">
        <div class="room-head">
          <p class="room-head__num" aria-hidden="true" data-room-num><span>05</span></p>
          <h2 class="room-head__en">Contact</h2>
          <p class="room-head__jp">Nº05 — 相談する</p>
        </div>

        <p class="contact__title">
          <a href="mailto:hello.rootscion@gmail.com"
            >Let's talk<span class="arrow" aria-hidden="true">↗</span></a
          >
        </p>

        <div class="contact__foot">
          <p class="contact__note" data-reveal>「まだ相談レベル」が、いちばん歓迎です。</p>
        </div>
      </div>
    </section>
  </main>

  <script>
    import { animate } from '../scripts/animations';
    animate();
  </script>
</Base>
