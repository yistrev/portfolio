---
import { SITE_NAME, SITE_DESCRIPTION, GTM_ID, GTM_ENABLED, OGP_IMAGE } from '../consts';

interface Props {
  title: string;
  description?: string;
}

const { title, description = SITE_DESCRIPTION } = Astro.props;

const year = new Date().getFullYear();
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(OGP_IMAGE, Astro.site);
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- OGP -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="ja_JP" />
    <meta name="twitter:card" content="summary_large_image" />

    {
      GTM_ENABLED && (
        <script is:inline define:vars={{ gtmId: GTM_ID }}>
          (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);})(window,document,'script','dataLayer',gtmId);
        </script>
      )
    }
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Syne:wght@600;700;800&family=Climate+Crisis&family=Geist+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />

    <!-- 和文: Adobe Fonts（DNP 秀英角ゴシック銀 Std / kit oez8avv） -->
    <link rel="preconnect" href="https://use.typekit.net" crossorigin />
    <link rel="preconnect" href="https://p.typekit.net" crossorigin />
    <script is:inline>
      (function (d) {
        var config = {
            kitId: 'oez8avv',
            scriptTimeout: 3000,
            async: true,
          },
          h = d.documentElement,
          t = setTimeout(function () {
            h.className = h.className.replace(/\bwf-loading\b/g, '') + ' wf-inactive';
          }, config.scriptTimeout),
          tk = d.createElement('script'),
          f = false,
          s = d.getElementsByTagName('script')[0],
          a;
        h.className += ' wf-loading';
        tk.src = 'https://use.typekit.net/' + config.kitId + '.js';
        tk.async = true;
        tk.onload = tk.onreadystatechange = function () {
          a = this.readyState;
          if (f || (a && a != 'complete' && a != 'loaded')) return;
          f = true;
          clearTimeout(t);
          try {
            Typekit.load(config);
          } catch (e) {}
        };
        s.parentNode.insertBefore(tk, s);
      })(document);
    </script>
  </head>
  <body>
    {
      GTM_ENABLED && (
        <noscript>
          <iframe
            src={`https://www.googletagmanager.com/ns.html?id=${GTM_ID}`}
            height="0"
            width="0"
            style="display:none;visibility:hidden"
            title="gtm"
          />
        </noscript>
      )
    }
    <!-- 追従ヘッダー: 罫も影も持たず、ロゴとMenuの2つのピルだけを版面に浮かせる -->
    <header class="site-header">
      <div class="site-header__inner">
        <a href="/" class="site-header__logo">
          <img src="/logo.svg" alt="rootscion" class="logo-wordmark" width="513" height="95" />
        </a>
        <button
          class="menu-toggle"
          data-menu-toggle
          aria-expanded="false"
          aria-controls="site-menu"
          aria-label="メニューを開く"
        >Menu</button>
      </div>
    </header>

    <!-- 開閉メニュー（閉じるキーは esc） -->
    <div class="menu" id="site-menu" hidden>
      <div class="menu__inner">
        <div class="menu__top">
          <span class="menu__brand">rootscion — index of rooms</span>
          <button class="menu__esc" data-menu-close aria-label="メニューを閉じる">esc</button>
        </div>
        <nav class="menu__nav" aria-label="サイト内メニュー">
          <a href="/#about"><span class="idx">Nº01</span><span>About</span><span class="jp">この場所について</span></a>
          <a href="/#capability"><span class="idx">Nº02</span><span>Capability</span><span class="jp">できることの展示</span></a>
          <a href="/#works"><span class="idx">Nº03</span><span>Works</span><span class="jp">手がけたもの</span></a>
          <a href="/#skills"><span class="idx">Nº04</span><span>Spec</span><span class="jp">仕様</span></a>
          <a href="/#profile"><span class="idx">Nº05</span><span>Profile</span><span class="jp">作り手について</span></a>
          <a href="/#contact"><span class="idx">Nº06</span><span>Contact</span><span class="jp">相談する</span></a>
        </nav>
        <p class="menu__meta">
          <a href="https://github.com/yistrev" target="_blank" rel="noopener">GitHub →</a>
          <a href="/engineer">Mode: engineer →</a>
        </p>
      </div>
    </div>

    <slot />

    <!-- フッター: 墨のベタ面に1行のモノスペース銘板 -->
    <footer class="site-footer">
      <p class="footer-bar">
        <span>&copy; {year} rootscion</span>
        <a href="/engineer">Mode: engineer →</a>
      </p>
    </footer>
    <script>
      import gsap from 'gsap';

      const toggle = document.querySelector('[data-menu-toggle]');
      const menu = document.getElementById('site-menu');
      const closeBtn = menu.querySelector('[data-menu-close]');
      const items = menu.querySelectorAll('.menu__nav a');
      const meta = menu.querySelector('.menu__meta');
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      let isOpen = false;

      function openMenu() {
        isOpen = true;
        menu.hidden = false;
        toggle.setAttribute('aria-expanded', 'true');
        document.body.classList.add('menu-open');
        if (!reduceMotion) {
          // パネル自体の opacity は触らない。透過中に裏の LET'S TALK 等が透けるため、
          // 不透明な墨の面のまま上から滑り込ませる（シャッター）
          gsap.fromTo(menu,
            { yPercent: -100 },
            { yPercent: 0, duration: 0.5, ease: 'expo.out' }
          );
          gsap.fromTo(items,
            { yPercent: 70, autoAlpha: 0 },
            { yPercent: 0, autoAlpha: 1, duration: 0.55, stagger: 0.06, ease: 'expo.out', delay: 0.18 }
          );
          gsap.fromTo(meta, { autoAlpha: 0, y: 14 }, { autoAlpha: 1, y: 0, duration: 0.4, ease: 'power2.out', delay: 0.4 });
        }
        closeBtn.focus();
      }

      function closeMenu() {
        isOpen = false;
        toggle.setAttribute('aria-expanded', 'false');
        document.body.classList.remove('menu-open');
        if (!reduceMotion) {
          gsap.to(menu, {
            yPercent: -100,
            duration: 0.34,
            ease: 'power3.in',
            onComplete: () => {
              menu.hidden = true;
              gsap.set([menu, items, meta], { clearProps: 'all' });
            },
          });
        } else {
          menu.hidden = true;
        }
        toggle.focus();
      }

      toggle.addEventListener('click', () => (isOpen ? closeMenu() : openMenu()));
      closeBtn.addEventListener('click', closeMenu);

      // 世界観どおり esc キーでも閉じる
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && isOpen) closeMenu();
      });

      // アンカー遷移時は即座に閉じる（スクロール先が見えるように）
      items.forEach((a) => {
        a.addEventListener('click', () => {
          isOpen = false;
          toggle.setAttribute('aria-expanded', 'false');
          document.body.classList.remove('menu-open');
          menu.hidden = true;
          gsap.set([menu, items, meta], { clearProps: 'all' });
        });
      });
    </script>
  </body>
</html>

<style is:global>
  @import '../styles/global.css';
</style>
